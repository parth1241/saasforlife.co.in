# Razorpay API Keys (Get from Dashboard -> Settings -> API Keys)
# WARNING: Do NOT prefix your Key Secret with VITE_ so it remains hidden from the client browser.
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Formspree Form ID (Get from Formspree Dashboard -> Form Settings -> Integration details)
VITE_FORMSPREE_ID=your_formspree_id_here

# MongoDB & JWT Settings (Used by Serverless API Backend - Keep Secure)
MONGODB_URI=mongodb+srv://admin:your_mongodb_password@cluster0.mongodb.net/saasforlife?retryWrites=true&w=majority
JWT_SECRET=your_jwt_signing_secret_here

# Google OAuth Client ID (Get from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
