# Razorpay API Keys (Get from Dashboard -> Settings -> API Keys)
# WARNING: Do NOT prefix your Key Secret with VITE_ so it remains hidden from the client browser.
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Formspree Form ID (Get from Formspree Dashboard -> Form Settings -> Integration details)
VITE_FORMSPREE_ID=your_formspree_id_here

# Crypto Wallet Addresses (Replace with your actual addresses)
VITE_CRYPTO_USDT_ADDR=your_usdt_trc20_wallet_address_here
VITE_CRYPTO_USDC_ADDR=your_usdc_erc20_wallet_address_here
VITE_CRYPTO_BTC_ADDR=your_btc_wallet_address_here
VITE_CRYPTO_ETH_ADDR=your_eth_wallet_address_here
